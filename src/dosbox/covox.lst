     1                                  ; Assemble with: nasm -f bin -o covox.com covox.asm -l covox.lst
     2                                  
     3                                             ;-----------------------------------
     4                                             ; MUZAK58 by wiRe/NpM
     5                                             ;-----------------------------------
     6                                              section .text
     7                                              org     100h
     8                                  
     9                                             ;--------------------------------- ;---------- ;muzak sequence table
    10 00000000 1314                      seqtbl:   dw      0x1413                    ;1314       ;  t * [3,1,4,1][3&t>>10]       ;! 1314       adc dx,[si]
    11 00000002 666C                                dw      0x6C66                    ;666C       ;    * [6,6,12,6][3&t>>11]      ;! 666C       o32 insb
    12 00000004 4222                                dw      0x2242                    ;4222       ;    * [2,4,2,2][3&t>>12]       ;! 42         inc dx
    13 00000006 9564                                dw      0x6495                    ;9564       ;    * [5,9,4,6][3&t>>13]       ;! 22956484   and dl,[di-0x7b9c]
    14 00000008 8444                                dw      0x4484                    ;8444       ;    * [4,8,4,4][3&t>>14] >> 8  ;! 44         inc sp
    15                                  
    16 0000000A B010                                mov     al, 0b00010000            ;B010       ;write 8253/8254 PIT command/mode register: resets PIT channel #0
    17 0000000C E643                                out     43h, al                   ;E643       ;  [7:6] channel #0, [5:4] LSB only, [3:1] mode0 (one-shot), [0] 16-bit binary
    18                                  
    19                                             ;--------------------------------- ;---------- ;present next audio sample (DX:BX = 32-bit sample counter)
    20 0000000E 0495                      bbeat:    add     al, 149                   ;04xx       ;  calculate new timer period (AL = 42..148)
    21 00000010 E640                                out     40h, al                   ;E640       ;  rearm timer
    22                                  
    23 00000012 43                                  inc     bx                        ;43         ;  increment 16-bit timer counter
    24                                  
    25 00000013 60                                  pusha                             ;60         ;  store all registers
    26                                             ;mov     si, seqtbl                ;BExxxx     ;  load address of sequence table into SI (here SI already points to seqtbl by default)
    27 00000014 89DA                                mov     dx, bx                    ;89DA       ;  load start value into DX
    28 00000016 B105                                mov     cl, 5                     ;B1xx       ;  init index counter inside CX (CH must be zero already!)
    29 00000018 51                        bbeat_lp: push    cx                        ;51         ;  store CX counter
    30 00000019 B10C                                mov     cl, 01100b                ;B1xx       ;  get bit sequence from time into CL
    31 0000001B 20F9                                and     cl, bh                    ;20F9       ;    CL := offset to 1 out of 4 entries
    32 0000001D AD                                  lodsw                             ;AD         ;  load next sequence table entry (AX := DS:[SI]; SI := SI + 2)
    33 0000001E D3C8                                ror     ax, cl                    ;D3C8       ;  select sequence entry at bit-offset 0, 4, 8 or 12
    34 00000020 83E00F                              and     ax, 01111b                ;83E00F     ;  each sequence entry is 4 bits only (AX &= 15)
    35 00000023 F7E2                                mul     dx                        ;F7E2       ;  multiply (DX:AX := AX ∗ DX)
    36 00000025 92                                  xchg    ax, dx                    ;92         ;    DX := updated 16-bit sample
    37 00000026 59                                  pop     cx                        ;59         ;  restore CX counter
    38 00000027 D1EB                                shr     bx, 1                     ;D1ED       ;  get next bit sequence from time
    39 00000029 E2ED                                loop    bbeat_lp                  ;E2xx       ;  loop until all bits are out
    40                                  
    41 0000002B 88F0                                mov     al, dh                    ;88F0       ;  get sample data into AL
    42 0000002D BA7803                              mov     dx, 0378h                 ;BA7803     ;  load LPT1 port address into DX
    43 00000030 EE                                  out     dx, al                    ;EE         ;  send 8-bit sample data to COVOX device
    44 00000031 61                                  popa                              ;61         ;  restore all registers (especially BX, CX, DX, SI)
    45                                  
    46                                    main_lp: ;--------------------------------- ;---------- ;read 8253/8254 PIT ch#0 counter value (ch#0 must be reconfigured to 0b00010000)
    47 00000032 E440                                in      al, 40h                   ;E440       ;  read low-byte
    48 00000034 3C94                                cmp     al, 148                   ;3Cxx       ;  did timer counter overflowed to 149..0FFh?
    49 00000036 70D6                                jo      short bbeat               ;71xx       ;    yes -> play
    50                                  
    51                                             ;... the place for your intro
    52                                  
    53 00000038 EBF8                                jmp     short main_lp             ;75xx       ;  loop forever
